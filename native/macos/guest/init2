#!/bin/sh
# Stage 2, PID 1 on tmpfs. Brings up exactly what the supervisor needs and nothing that talks to anything:
# there is no network device in this machine, and none is configured here beyond loopback.
export PATH=/usr/bin:/bin:/usr/sbin:/sbin
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mkdir -p /dev/pts /dev/shm
mount -t devpts devpts /dev/pts
mount -t tmpfs tmpfs /dev/shm
mount -t tmpfs tmpfs /tmp
mount -t tmpfs tmpfs /run
# Dependency order, by hand: there is no depmod database in this image and nothing else is ever loaded.
for m in vsock vmw_vsock_virtio_transport_common vmw_vsock_virtio_transport rng-core virtio-rng; do
  [ -f "/lib/probant-modules/$m.ko" ] && insmod "/lib/probant-modules/$m.ko" 2>/dev/null
done
ip link set lo up 2>/dev/null || ifconfig lo 127.0.0.1 up
hostname probant-guest
export HOME=/root PYTHONPATH=/opt/probant/client PYTHONDONTWRITEBYTECODE=1 LANG=C.UTF-8
cd /
python3 -m inferroute_local.macos_vm.guest
echo "PROBANT_GUEST_SUPERVISOR_EXIT $?" > /dev/console 2>/dev/null
# THE HOST STOPS THIS MACHINE; it never stops itself. The runner treats a guest that halts before the
# host's own teardown as a failure ("guest stopped before host teardown proof") and the session's outputs
# are then discarded — so a clean finish must WAIT here to be force-stopped. PID 1 exiting would also panic.
while :; do sleep 3600; done
